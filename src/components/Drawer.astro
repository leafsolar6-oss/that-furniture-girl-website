---
import { CONFIG } from '../data/products.js';
---

<aside class="drawer" id="drawer" aria-label="Menu">
  <div class="drawer__top">
    <span class="brand__name">{CONFIG.brand}</span>
    <button class="drawer__close" type="button" data-close-drawer aria-label="Close menu">&times;</button>
  </div>
  <div class="drawer__foot">
    <a class="btn btn--primary btn--block" href={`https://wa.me/${CONFIG.whatsapp}`} data-wa="Hello! I would like to order furniture.">Order on WhatsApp</a>
    <div class="drawer__meta">
      <span>Iyaganku, New GRA, Ibadan</span>
      <span>{CONFIG.phoneDisplay} &middot; @thatfurnituregirl__</span>
    </div>
  </div>
</aside>
