---
/* Site footer — cream sheet, four columns, icon contact rows, delivery
   chips. Identical on every page, so it lives here once. */
import { CONFIG } from '../data/products.js';

const YEAR = 2026; // 2026 in the static HTML; the script refreshes it in the browser
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand brand--footer" href="index.html">
          <img src="assets/img/logo-full.webp?v=2" alt={`${CONFIG.brand} — crafted for real living`}
               width="230" height="170" loading="lazy">
        </a>
        <p class="footer-brand__motto">…crafted for real living</p>
        <p>Furniture built to last in Iyaganku, New GRA, Ibadan. Unique, classy and sturdy — made to order in any colour, size or design.</p>
        <div class="socials">
          <a href={CONFIG.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.8a5.2 5.2 0 0 0 3.4 1.3V9.4a7.6 7.6 0 0 1-3.9-1.1v5.4a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v2.5a3.1 3.1 0 1 0 2.2 3V2h2.5a5.2 5.2 0 0 0 .5 3.8z"/></svg>
          </a>
          <a href={CONFIG.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href={`https://wa.me/${CONFIG.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4>Browse</h4>
        <div class="footer-links">
          <a href="products.html">All products</a>
          <a href="catalogue.html">Catalogue</a>
          <a href="products.html#cat-sofas">Sofas</a>
          <a href="products.html#cat-sets">Sets</a>
          <a href="products.html#cat-tables">Tables</a>
          <a href="products.html#cat-storage">Storage</a>
        </div>
      </div>
      <div>
        <h4>Follow</h4>
        <div class="footer-links">
          <a href={CONFIG.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={CONFIG.tiktok} target="_blank" rel="noopener">TikTok</a>
          <a href={`https://wa.me/${CONFIG.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
      <div>
        <h4>Contact</h4>
        <div class="footer-contact">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
            Iyaganku, New GRA,<br>Ibadan 200273, Oyo State
          </span>
          <a href={`https://wa.me/${CONFIG.whatsapp}`} data-wa="Hello! I would like to make an enquiry.">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/></svg>
            WhatsApp {CONFIG.phoneDisplay}
          </a>
          <a href={`tel:+${CONFIG.whatsapp}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3h2l1.5 4-2 1.4a12 12 0 0 0 5.6 5.6L15 12l4 1.5v2a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/></svg>
            Call {CONFIG.phoneDisplay}
          </a>
        </div>
      </div>
    </div>

    <div class="pay-chips">
      <span>Bank transfer</span>
      <span>Order on WhatsApp</span>
      <span>Nationwide delivery</span>
    </div>
    <div class="footer-bottom">
      <span>&copy; <span data-year>{YEAR}</span> {CONFIG.brand}. All rights reserved.</span>
      <span>Prices are for the pieces as photographed · Creative direction @justBlairsin</span>
    </div>
  </div>
</footer>
