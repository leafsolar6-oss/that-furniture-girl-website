---
/* Site header. Two destinations only — home and the product page — plus
   search and WhatsApp. The current page is marked from a prop. */
import { CONFIG } from '../data/products.js';

const { page = '' } = Astro.props;
const here = (key) => (page === key ? 'page' : undefined);
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a class="brand" href="index.html">
      <span class="brand__mark"><img src="assets/img/logo-mark-light.webp" alt={`${CONFIG.brand} logo`} width="36" height="36"></span>
      <span class="brand__text">
        <span class="brand__name">{CONFIG.brand}</span>
        <span class="brand__sub">…crafted for real living</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href="index.html" aria-current={here('home')}>Home</a>
      <a href="products.html" aria-current={here('products')}>Products</a>
      <a href="lookbook.html" aria-current={here('lookbook')}>Lookbook</a>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" data-open-search aria-label="Search pieces">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      </button>
      <a class="btn btn--gold btn--sm" href={`https://wa.me/${CONFIG.whatsapp}`} data-wa="Hello! I would like to order furniture.">Order on WhatsApp</a>
      <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false"><span></span></button>
    </div>
  </div>
</header>
