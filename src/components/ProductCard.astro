---
/* One product card. This replaces cardHTML() from the old main.js — the
   markup is byte-for-byte the same, but it is rendered at build time, so the
   grid is visible before any JavaScript runs (better for SEO and for slow
   Nigerian mobile connections).

   The data-* attributes are what the browser script filters on, so no
   re-rendering happens when a customer taps a tab. */
import { waLink, orderMessage, priceInfo, specParts, badgesFor, catLabel } from '../lib/site.js';

const { product: p, delay = 0 } = Astro.props;
const wa = waLink(orderMessage(p));
const price = priceInfo(p);
const specs = specParts(p);
const badges = badgesFor(p);
---

<article class="product reveal" data-delay={delay} data-id={p.id}
         data-cat={p.cat} data-price={p.price || ''} data-search={p.haystack}>
  <div class="product__media">
    <span class="product__label">{catLabel(p.cat)}</span>
    <img src={`assets/img/opt/${p.img}`} alt={`${p.name} — ${p.colours || 'handmade furniture'}`}
         loading="lazy" width="900" height="675">
    <div class="badges">
      {badges.map((b) => <span class={`badge badge--${b.tone}`}>{b.label}</span>)}
    </div>
    <div class="product__tools">
      <button class="icon-btn js-quick" type="button" aria-label={`Quick view: ${p.name}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
      <a class="icon-btn icon-btn--green" href={wa} target="_blank" rel="noopener" aria-label={`Order ${p.name} on WhatsApp`}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z"/></svg>
      </a>
    </div>
  </div>
  <div class="product__body">
    <h3 class="product__name">{p.name}</h3>
    <p class="product__spec">
      {specs.map((s, i) => <>{i > 0 ? ' · ' : ''}<b>{s.k}:</b> {s.v}</>)}
    </p>
    <div class="product__foot">
      <div class={`price${price.ask ? ' price--ask' : ''}`}>
        <span class="price__value">{price.value}</span>
        <span class="price__note">{price.note}</span>
      </div>
      <a class="btn btn--wa btn--sm" href={wa} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z"/></svg>
        <span>Chat</span>
      </a>
    </div>
  </div>
</article>
