---
/* The search overlay. Results are rendered in the browser from the product
   data (see src/scripts/site.js) so typing stays instant. */
---

<div class="search-panel" id="searchPanel" role="dialog" aria-modal="true" aria-label="Search pieces">
  <div class="search-panel__inner">
    <div class="search-panel__bar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      <input type="text" placeholder="Search sofas, wardrobes, tables…" aria-label="Search pieces">
      <button class="search-panel__close" type="button" aria-label="Close search">&times;</button>
    </div>
    <div class="search-panel__results"></div>
  </div>
</div>
