---
/* Three category tiles: sofas, full sets, tables & storage. */
---

<section class="section section--flush-top" id="categories">
    <div class="container">
      <div class="cat-grid">

        <div class="cat-col reveal">
          <article class="cat-card">
            <span class="cat-card__count">3 designs</span>
            <h3>Sofas &amp; Sectionals</h3>
            <p>Our biggest builds. Deep channel tufting and soft boucle, framed in treated wood and filled with high-density foam.</p>
            <div class="cat-card__list">
              <a href="shop.html#cat-sofas">Blush Sectional &mdash; &#8358;500,000</a>
              <a href="shop.html#cat-sofas">Jewel L-Shaped Sectional &mdash; &#8358;350,000</a>
              <a href="shop.html#cat-sofas">Plush 3-Seater &mdash; price on request</a>
            </div>
            <img class="cat-card__img cat-card__img--flat" src="assets/img/opt/blush-sectional.jpg" alt="Blush Sectional in light grey and white boucle" width="900" height="563" loading="lazy">
          </article>
        </div>

        <div class="cat-col">
          <article class="cat-card cat-card--split reveal" data-delay="1">
            <div>
              <span class="cat-card__count">3 designs</span>
              <h3>Full Sets</h3>
              <p>Sectional, chairs and table together — the whole room in one order.</p>
              <div class="cat-card__list" style="margin-top:14px">
                <a href="shop.html#cat-sets">Blush Linea Set &mdash; &#8358;450,000</a>
                <a href="shop.html#cat-sets">The Twinkle Set</a>
                <a href="shop.html#cat-sets">Royal Kinging Set &mdash; &#8358;1,500,000</a>
              </div>
            </div>
            <img class="cat-card__img cat-card__img--flat" src="assets/img/opt/twinkle-set.jpg" alt="The Twinkle Set" width="900" height="675" loading="lazy">
          </article>

          <article class="cat-card cat-card--split reveal" data-delay="2">
            <div>
              <span class="cat-card__count">2 designs</span>
              <h3>Tables &amp; Storage</h3>
              <p>Centre tables and wardrobes, sized to fit the space you actually have.</p>
              <div class="cat-card__list" style="margin-top:14px">
                <a href="shop.html#cat-tables">Centre Table &mdash; &#8358;100,000</a>
                <a href="shop.html#cat-storage">Wardrobe &mdash; from &#8358;140,000</a>
              </div>
            </div>
            <img class="cat-card__img cat-card__img--flat" src="assets/img/opt/wardrobe.jpg" alt="Wardrobe handmade in Ibadan" width="900" height="675" loading="lazy">
          </article>
        </div>

      </div>
    </div>
  </section>

  <!-- collection --------------------------------------------------------- -->
