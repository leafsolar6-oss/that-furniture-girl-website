---
/* The collection band: heading, filter toolbar and the product grid.
   Everything below is rendered at build time from src/data/products.js. */
import Toolbar from '../Toolbar.astro';
import ProductGrid from '../ProductGrid.astro';
import { PRODUCTS } from '../../data/products.js';

const products = PRODUCTS;
---

<section class="section" id="collection">
  <div class="container">
    <Toolbar title="Trending collections" gridId="featuredGrid" />

    <ProductGrid products={products} id="featuredGrid" />
  </div>
</section>
