---
/* FAQ — every answer is a fact already published elsewhere on the site or in
   the catalogue data. No payment or policy claims we cannot stand behind. */
const faqs = [
  ['How do I order?', 'On WhatsApp only. Tap Chat on any piece and a pre-filled message opens with the piece name and price — send it and we take it from there.'],
  ['How long does a build take?', 'It takes 5 to 14 working days or more, depending on the design. Some pieces are available for immediate pickup; ornate sets like the Royal Kinging take about three months.'],
  ['Can I change the colour, size or fabric?', 'Yes. Every piece is built to order, so colour, size and design follow your specification — send a reference and we quote it.'],
  ['Do you deliver outside Ibadan?', 'Yes — same-day delivery inside Ibadan and nationwide shipping across Nigeria. Delivery is free on orders over ₦2,000,000 (T&Cs apply).'],
  ['Can I visit before ordering?', 'Yes. The showroom is at Iyaganku, New GRA, Ibadan — message us on WhatsApp and we will plan a time for you to come and sit on the pieces.'],
];
---

<section class="section faqband" id="faq">
  <div class="container container--narrow">
    <span class="kicker">Questions</span>
    <h2>Before you ask</h2>
    <div class="faq">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}<span aria-hidden="true">+</span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
