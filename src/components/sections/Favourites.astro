---
/* This week's two favourites. */
---

<section class="section section--flush-top">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <div class="section-head__text">
          <span class="eyebrow">Most requested</span>
          <h2>This week's two favourites</h2>
          <p class="lead" style="margin-top:14px">The pieces people ask about most — both can be built in your colour, size and fabric.</p>
        </div>
        <a class="link-arrow" href="shop.html">View all
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="deal-grid">
        <article class="deal reveal">
          <div class="deal__media"><img src="assets/img/opt/blush-sectional.jpg" srcset="assets/img/opt/blush-sectional-480.jpg 480w, assets/img/opt/blush-sectional.jpg 1000w" sizes="(min-width:860px) 44vw, 88vw" alt="Blush Sectional in light grey and white boucle" width="900" height="675" loading="lazy"></div>
          <div class="deal__body">
            <span class="badge badge--green" style="align-self:flex-start">Available now</span>
            <h3 class="deal__name">Blush Sectional</h3>
            <div class="deal__price"><b>&#8358;500,000</b><span>Custom colours available</span></div>
            <p class="deal__desc">Light grey and white boucle with deep channel tufting. Treated wood frame, high-density foam — ours to deliver today.</p>
            <a class="btn btn--sm" href="https://wa.me/2349079849626" data-wa="Hello! I would like to order the Blush Sectional (&#8358;500,000). Is it available?">Shop now</a>
          </div>
        </article>

        <article class="deal reveal" data-delay="1">
          <div class="deal__media"><img src="assets/img/opt/jewel-sectional.jpg" srcset="assets/img/opt/jewel-sectional-480.jpg 480w, assets/img/opt/jewel-sectional.jpg 1000w" sizes="(min-width:860px) 44vw, 88vw" alt="Jewel L-Shaped Sectional in chocolate brown corduroy" width="900" height="675" loading="lazy"></div>
          <div class="deal__body">
            <span class="badge badge--green" style="align-self:flex-start">Available now</span>
            <h3 class="deal__name">Jewel L-Shaped Sectional</h3>
            <div class="deal__price"><b>&#8358;350,000</b><span>Custom colours available</span></div>
            <p class="deal__desc">Chocolate brown corduroy in an L-shape that fits a corner properly. Ready for immediate pickup from the showroom.</p>
            <a class="btn btn--sm" href="https://wa.me/2349079849626" data-wa="Hello! I would like to order the Jewel L-Shaped Sectional (&#8358;350,000). Is it available?">Shop now</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- promo pair -->
