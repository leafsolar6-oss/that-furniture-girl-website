---
/* Same-day delivery, custom colours, built to last. */
---

<section class="section section--sm">
    <div class="container">
      <div class="features reveal">
        <div class="feature">
          <span class="feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h10v9H3z"/><path d="M13 10h3.4L20 13.2V16h-7z"/><circle cx="6.5" cy="18" r="1.7"/><circle cx="16.5" cy="18" r="1.7"/></svg>
          </span>
          <div>
            <h4>Same-day delivery</h4>
            <p>Order before noon and we deliver across Ibadan the same day. Nationwide delivery arranged.</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.3A4.7 4.7 0 0 0 22 9.7C21.7 5.9 17.3 3 12 3Z"/><circle cx="7.6" cy="11.4" r="1.1"/><circle cx="11" cy="7.4" r="1.1"/><circle cx="15.6" cy="8.6" r="1.1"/></svg>
          </span>
          <div>
            <h4>Custom colours &amp; sizes</h4>
            <p>Boucle, corduroy, floral or leather — built to your measurements, at no extra design fee.</p>
          </div>
        </div>
        <div class="feature">
          <span class="feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2 5.5 5.5 2-5.5 2-2 5.5-2-5.5L4.5 11l5.5-2z"/><path d="M18.5 3.2l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7z"/></svg>
          </span>
          <div>
            <h4>Built to last</h4>
            <p>Treated wood frames, high-density foam and hand-finished upholstery — made in our own workshop.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

