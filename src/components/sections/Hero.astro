---
/* Hero — copy + stats on the left, the product panel on the right.
   Matches the reference store's hero layout. */
import { CONFIG } from '../../data/products.js';
import { heroProducts } from '../../data/products.js';
import { waLink, orderMessage, priceInfo, categoryLabel } from '../../lib/site.js';

const first = heroProducts[0];
const firstPrice = priceInfo(first);
---

<section class="hero relative overflow-hidden">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container relative">
    <div class="hero__grid">

      <div class="hero__copy reveal flex flex-col items-center text-center lg:items-start lg:text-left">
        <span class="hero__eyebrow">→ New collection 2026</span>
        <h1 class="hero__title">Furniture that<br><em>Transforms</em><br>Your living space</h1>
        <p class="hero__sub">Discover handcrafted furniture pieces that blend exceptional craftsmanship with modern design. Create the home you've always dreamed of.</p>
        <div class="btn-row">
          <a class="btn btn--gold btn--lg" href="#collection">
            Shop collection
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn--outline btn--lg" href="products.html">View products</a>
        </div>

        <div class="stats">
          <div class="stat"><b>1,101</b><span>TikTok followers</span></div>
          <div class="stat"><b>59,230</b><span>Likes across our builds</span></div>
          <div class="stat"><b>191</b><span>Videos of real work</span></div>
        </div>
      </div>

      <div class="hero__panel reveal" data-delay="1" id="heroPanel" aria-roledescription="carousel" aria-label="Pieces from the workshop">
        <div class="hero__slides" id="heroSlides">
          {heroProducts.map((p, i) => {
            const price = priceInfo(p);
            const shown = price.ask ? 'Price on request' : price.value;
            return (
              <a class={`hero__slide${i === 0 ? ' is-on' : ''}`}
                 href={waLink(orderMessage(p))}
                 target="_blank" rel="noopener"
                 data-name={p.name}
                 data-price={shown}
                 data-badge={p.badge || categoryLabel(p.cat)}
                 aria-label={`${p.name} — order on WhatsApp`}>
                <img src={`assets/img/opt/${p.img}`} alt={`${p.name} — ${p.colours} by ${CONFIG.brand}`}
                     loading={i === 0 ? 'eager' : 'lazy'} width="900" height="1125">
              </a>
            );
          })}
        </div>

        <div class="hero__card">
          <span class="hero__badge" id="heroBadge">{first.badge || categoryLabel(first.cat)}</span>
          <strong id="heroName">{first.name}</strong>
          <span class="hero__price" id="heroPrice">{firstPrice.ask ? 'Price on request' : firstPrice.value}</span>
        </div>

        <button class="hero__arrow" type="button" data-hero="-1" aria-label="Previous piece">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button class="hero__arrow" type="button" data-hero="1" aria-label="Next piece">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>

        <div class="hero__dots" id="heroDots"></div>
      </div>

    </div>
  </div>
</section>
