---
/* Follow us — real Instagram photos. */
---

<section class="section section--flush-top">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Follow us</span>
        <h2>Fresh from the workshop on Instagram</h2>
        <p class="lead" style="margin-top:14px">New pieces are posted most weeks — that is usually how customers meet their next sofa.</p>
      </div>
      <div class="ig-grid reveal">
        <a class="ig-tile" href="https://www.instagram.com/thatfurnituregirl__" target="_blank" rel="noopener"><img src="assets/img/ig/ig-1.jpg" alt="Cream boucle sectional set from our Instagram" width="640" height="640" loading="lazy"></a>
        <a class="ig-tile" href="https://www.instagram.com/thatfurnituregirl__" target="_blank" rel="noopener"><img src="assets/img/ig/ig-2.jpg" alt="Boucle sectional detail" width="640" height="640" loading="lazy"></a>
        <a class="ig-tile ig-tile--link" href="https://www.instagram.com/thatfurnituregirl__" target="_blank" rel="noopener" aria-label="Follow @thatfurnituregirl__ on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
          <span>@thatfurnituregirl__</span>
        </a>
        <a class="ig-tile" href="https://www.instagram.com/thatfurnituregirl__" target="_blank" rel="noopener"><img src="assets/img/ig/ig-3.jpg" alt="Finished sofa in the workshop" width="640" height="640" loading="lazy"></a>
        <a class="ig-tile" href="https://www.instagram.com/thatfurnituregirl__" target="_blank" rel="noopener"><img src="assets/img/ig/ig-4.jpg" alt="Sectional with cushions" width="640" height="640" loading="lazy"></a>
      </div>
    </div>
  </section>

