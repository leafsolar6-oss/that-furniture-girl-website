---
/* Newsletter — hands off to WhatsApp. */
---

<section class="section section--flush-top">
    <div class="container">
      <div class="newsletter reveal">
        <span class="eyebrow" style="justify-content:center">Our updates</span>
        <h2>Get first look at what comes off the bench</h2>
        <p>New pieces, new fabrics and what is ready for pickup — sent to you on WhatsApp. No spam, and you can ask us to stop any time.</p>
        <form id="newsletterForm" novalidate>
          <input type="text" name="who" placeholder="Your name or number" aria-label="Your name or number">
          <button class="btn btn--amber" type="submit">Get updates</button>
        </form>
        <p class="newsletter__fine">Opens WhatsApp with your details ready to send.</p>
      </div>
    </div>
  </section>

