---
/* Two promo cards: sofas, wardrobes & storage. */
---

<section class="section section--flush-top">
    <div class="container">
      <div class="promo-grid">
        <article class="promo reveal">
          <div>
            <h3>Sofas &amp; Sectionals</h3>
            <p>Three designs, every one made to your measurements.</p>
            <a class="btn btn--sm" href="shop.html#cat-sofas">Shop now</a>
          </div>
          <div class="promo__media"><img src="assets/img/opt/hero-sectionals.jpg" srcset="assets/img/opt/hero-sectionals-800.jpg 800w, assets/img/opt/hero-sectionals.jpg 1400w" sizes="(min-width:860px) 44vw, 88vw" alt="Grey boucle sectional sofa" width="900" height="675" loading="lazy"></div>
        </article>
        <article class="promo promo--amber reveal" data-delay="1">
          <div>
            <h3>Wardrobes &amp; Storage</h3>
            <p>Built to fit the wall you actually have. From &#8358;140,000.</p>
            <a class="btn btn--sm" href="shop.html#cat-storage">Shop now</a>
          </div>
          <div class="promo__media"><img src="assets/img/opt/wardrobe.jpg" srcset="assets/img/opt/wardrobe-480.jpg 480w, assets/img/opt/wardrobe.jpg 1000w" sizes="(min-width:860px) 44vw, 88vw" alt="Wardrobe in matte MDF with black detailing" width="900" height="675" loading="lazy"></div>
        </article>
      </div>
    </div>
  </section>

  <!-- signature ---------------------------------------------------------- -->
