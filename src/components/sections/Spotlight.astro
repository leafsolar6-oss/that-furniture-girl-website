---
/* Ready right now — pieces actually finished in the showroom. */
---

<section class="section section--sm">
    <div class="container">
      <div class="spotlight reveal">
        <div>
          <span class="spotlight__label">Ready right now</span>
          <h2>Take it home today.</h2>
          <p class="spotlight__note">These pieces are finished and sitting in the showroom at Iyaganku. Message us before noon and we'll deliver across Ibadan the same day.</p>
          <div class="counter">
            <div class="counter__box"><b>2</b><span>Finished<br>pieces</span></div>
            <div class="counter__box"><b>Same</b><span>Day<br>delivery</span></div>
            <div class="counter__box"><b>5–10</b><span>Days to<br>build</span></div>
            <div class="counter__box"><b>Any</b><span>Colour<br>&amp; size</span></div>
          </div>
          <div class="btn-row">
            <a class="btn" href="https://wa.me/2349079849626" data-wa="Hello! Which pieces do you have ready for pickup right now?">Ask what's ready</a>
            <a class="btn btn--outline" href="shop.html">See all pieces</a>
          </div>
        </div>
        <div class="spotlight__media">
          <img src="assets/img/opt/blush-sectional.jpg" srcset="assets/img/opt/blush-sectional-480.jpg 480w, assets/img/opt/blush-sectional.jpg 1000w" sizes="(min-width:860px) 44vw, 88vw" alt="Blush Sectional in light grey boucle, ready in the Iyaganku showroom" width="900" height="675" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- deals of the day -> this week's most requested -->
