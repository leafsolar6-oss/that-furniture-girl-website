---
/* Numbers band — the workshop's public proof, given room to breathe:
   cream canvas, dashed seams, serif count-up numerals, gold small-caps. */
const stats = [
  { value: 1101,  label: 'TikTok followers',       icon: 'note'  },
  { value: 59230, label: 'Likes across our builds', icon: 'heart' },
  { value: 191,   label: 'Videos of real work',     icon: 'play'  },
];
const fmt = (n) => n.toLocaleString('en-US');
---

<section class="stats-band" aria-label="That Furniture Girl by the numbers">
  <div class="container">
    <p class="stats-band__kicker kicker">The workshop, in numbers</p>
    <div class="stats-band__grid">
      {stats.map((s) => (
        <div class="statcell">
          {s.icon === 'note' && (
            <svg class="statcell__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          )}
          {s.icon === 'heart' && (
            <svg class="statcell__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
          )}
          {s.icon === 'play' && (
            <svg class="statcell__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M10 8.5l6 3.5-6 3.5z"/></svg>
          )}
          <b class="statcell__num" data-count={s.value}>{fmt(s.value)}</b>
          <span class="statcell__rule" aria-hidden="true"></span>
          <span class="statcell__label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
