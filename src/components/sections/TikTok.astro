---
/* Loved on TikTok — real numbers. */
---

<section class="section section--ink">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <div class="section-head__text">
          <span class="eyebrow">Loved on TikTok</span>
          <h2>191 videos. One very busy workshop.</h2>
          <p class="lead" style="margin-top:16px">You probably found us on TikTok — that's where most of our customers meet their next sofa. Come and see what's on the bench right now.</p>
        </div>
        <a class="btn btn--ghost-light" href="https://www.tiktok.com/@thatfurnituregirl_" target="_blank" rel="noopener">Watch on TikTok</a>
      </div>
      <div class="stats" style="margin-top:clamp(34px,5vw,54px)">
        <div class="stat reveal"><strong>1,101</strong><span>TikTok followers</span></div>
        <div class="stat reveal" data-delay="1"><strong>59,230</strong><span>Likes from customers</span></div>
        <div class="stat reveal" data-delay="2"><strong>191</strong><span>Videos of our builds</span></div>
        <div class="stat reveal" data-delay="3"><strong>57,172</strong><span>Views on the Blush Sectional</span></div>
      </div>
    </div>
  </section>

  <!-- testimonials — stays hidden until real customer messages are added
       to TFG_TESTIMONIALS in assets/js/products.js -->
