---
/* Loved on TikTok — real numbers, rounded down through soc() so the page
   stays true between updates. */
import { CONFIG } from '../../data/products.js';
import { soc } from '../../lib/site.js';
const vids = soc(CONFIG.social.tiktokVideos);
const stats = [
  ['TikTok followers', CONFIG.social.tiktokFollowers],
  ['Likes from customers', CONFIG.social.tiktokLikes],
  ['Videos of our builds', CONFIG.social.tiktokVideos],
  ['Views on the Blush Sectional', CONFIG.social.blushViews],
].map(([label, n]) => ({ label, ...soc(n) }));
---

<section class="section section--ink">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <div class="section-head__text">
          <span class="eyebrow">Loved on TikTok</span>
          <h2>{vids.text} videos. One very busy workshop.</h2>
          <p class="lead" style="margin-top:16px">You probably found us on TikTok — that's where most of our customers meet their next sofa. Come and see what's on the bench right now.</p>
        </div>
        <a class="btn btn--ghost-light" href="https://www.tiktok.com/@thatfurnituregirl_" target="_blank" rel="noopener">Watch on TikTok</a>
      </div>
      <div class="stats" style="margin-top:clamp(34px,5vw,54px)">
        {stats.map((st, i) => (
          <div class="stat reveal" data-delay={i % 4}><strong>{st.text}</strong><span>{st.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- testimonials — stays hidden until real customer messages are added
       to TFG_TESTIMONIALS in assets/js/products.js -->
