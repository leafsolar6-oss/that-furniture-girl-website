---
/* The workshop band — real photos, real counts. Nothing here is invented:
   the three numbers are the same verified figures the hero shows. */
import { CONFIG } from '../../data/products.js';
import { soc } from '../../lib/site.js';
---

<section class="section workshop" id="workshop">
  <div class="container split">
    <div class="split__media">
      <picture>
        <source srcset="assets/img/opt/atelier-800.webp 800w, assets/img/opt/atelier.webp 1400w" sizes="(min-width:860px) 46vw, 92vw" type="image/webp">
        <img src="assets/img/opt/atelier.jpg" srcset="assets/img/opt/atelier-800.jpg 800w, assets/img/opt/atelier.jpg 1400w" sizes="(min-width:860px) 46vw, 92vw" alt={`Inside the ${CONFIG.brand} workshop in Ibadan`} loading="lazy" width="1000" height="853">
      </picture>
      <span class="wm wm--w2" aria-hidden="true"></span>
      <picture class="split__media-second">
        <source srcset="assets/img/opt/showroom-800.webp 800w, assets/img/opt/showroom.webp 1400w" sizes="(min-width:860px) 46vw, 92vw" type="image/webp">
        <img src="assets/img/opt/showroom.jpg" srcset="assets/img/opt/showroom-800.jpg 800w, assets/img/opt/showroom.jpg 1400w" sizes="(min-width:860px) 46vw, 92vw" alt={`${CONFIG.brand} showroom`} loading="lazy" width="1400" height="874">
      </picture>
    </div>
    <div class="split__copy">
      <span class="kicker">The workshop</span>
      <h2>A workshop you can watch</h2>
      <p class="lead">
        Every piece on this site is built to order in Ibadan — and most of them were
        filmed while being made. No stock photography, no imported showroom: the sofa
        you order is the sofa you can watch being stitched, tufted and wrapped on our
        TikTok and Instagram.
      </p>
      <div class="proof">
        <a class="proof__chip" href={CONFIG.tiktok} target="_blank" rel="noopener">
          <b>{soc(CONFIG.social.tiktokVideos).text}</b><span>videos of real builds</span>
        </a>
        <a class="proof__chip" href={CONFIG.tiktok} target="_blank" rel="noopener">
          <b>{soc(CONFIG.social.tiktokLikes).text}</b><span>likes across our work</span>
        </a>
        <a class="proof__chip" href={CONFIG.tiktok} target="_blank" rel="noopener">
          <b>{soc(CONFIG.social.tiktokFollowers).text}</b><span>followers watching</span>
        </a>
        <a class="proof__chip" href={CONFIG.instagram} target="_blank" rel="noopener">
          <b>{soc(CONFIG.social.instagramFollowers).text}</b><span>Instagram followers</span>
        </a>
      </div>
    </div>
  </div>
</section>
