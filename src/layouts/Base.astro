---
/* ==========================================================================
   Base layout — the shell every page shares: <head>, announcement bar,
   header, mobile drawer, footer, search overlay, quick-view modal, the
   floating WhatsApp button and the site script.
   Per-page things (title, description, nav highlight) come in as props.
   ========================================================================== */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPanel from '../components/SearchPanel.astro';
import ProductModal from '../components/ProductModal.astro';
import Fab from '../components/Fab.astro';
import Drawer from '../components/Drawer.astro';
import { CONFIG, PRODUCTS } from '../data/products.js';

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImagePath = '',
  page = ''
} = Astro.props;

/* Share + SEO: canonical url, a real og:image and structured data, so a link
   pasted into WhatsApp previews like a shop window instead of a bare title. */
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = new URL(base + (ogImagePath || 'assets/img/opt/blush-sectional.jpg'), Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FurnitureStore',
      name: CONFIG.brand,
      image: ogImage,
      telephone: '+' + CONFIG.whatsapp,
      priceRange: '\u20a6100,000 - \u20a61,500,000',
      address: { '@type': 'PostalAddress', streetAddress: CONFIG.address, addressCountry: 'NG' },
      areaServed: 'Nigeria',
      sameAs: [CONFIG.instagram, CONFIG.tiktok]
    },
    {
      '@type': 'ItemList',
      itemListElement: PRODUCTS.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Product',
          name: p.name,
          url: new URL(base + p.id + '.html', Astro.site).href,
          image: new URL(base + 'assets/img/opt/' + p.img, Astro.site).href,
          description: p.desc,
          offers: p.price ? {
            '@type': 'Offer',
            priceCurrency: 'NGN',
            price: p.price,
            availability: /pickup/i.test(p.lead || '')
              ? 'https://schema.org/InStock'
              : 'https://schema.org/MadeToOrder'
          } : undefined
        }
      }))
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en-NG">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#FFFFFF">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="900">
  <meta property="og:image:height" content="619">
  <meta property="og:image:alt" content="Blush Sectional on the studio backdrop — That Furniture Girl, Ibadan">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <link rel="canonical" href={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23004B1F'/%3E%3Cg fill='none' stroke='%23FFB600' stroke-width='1.7' stroke-linecap='round'%3E%3Cpath d='M8 17v-4.5A2.5 2.5 0 0 1 10.5 10h11A2.5 2.5 0 0 1 24 12.5V17'/%3E%3Cpath d='M6 18a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v3H6z'/%3E%3Cpath d='M9 21v2M23 21v2'/%3E%3C/g%3E%3C/svg%3E">
  <link rel="preload" as="font" type="font/woff2" href={base + 'assets/fonts/instrument-serif-latin.woff2'} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={base + 'assets/fonts/instrument-serif-italic-latin.woff2'} crossorigin>
  {(page === 'home' || page === 'piece') && <link rel="preload" as="image" type="image/webp" href={new URL(base + (page === 'home' ? 'assets/img/opt/blush-sectional.webp' : (ogImagePath || '').replace(/\.jpg$/, '.webp')), Astro.site).href} fetchpriority="high">}
  <link rel="stylesheet" href="assets/css/style.css?v=20261020A">
  <link rel="stylesheet" href="assets/css/arrangement.css?v=20261020A">
</head>
<body class={`page-${page || 'home'}`}>
<a class="skip-link" href="#main">Skip to content</a>

<!-- announcement ------------------------------------------------------- -->
<div class="announce" aria-hidden="true">
  <div class="announce__track">
    <div class="announce__group">
      <span>Same-day delivery in Ibadan &amp; nationwide</span><span class="announce__dot"></span>
      <span>Custom colours, sizes &amp; designs</span><span class="announce__dot"></span>
      <span>Order on WhatsApp &middot; {CONFIG.phoneDisplay}</span><span class="announce__dot"></span>
    </div>
    <div class="announce__group" data-announce-echo>
      <span>Same-day delivery in Ibadan &amp; nationwide</span><span class="announce__dot"></span>
      <span>Custom colours, sizes &amp; designs</span><span class="announce__dot"></span>
      <span>Order on WhatsApp &middot; {CONFIG.phoneDisplay}</span><span class="announce__dot"></span>
    </div>
  </div>
</div>

<Header page={page} />
<Drawer page={page} />

<div class="scrim" id="scrim"></div>

<main id="main">
  <slot />
</main>

<Footer />
<Fab />

<SearchPanel />
<ProductModal />

<noscript>
  <div class="container" style="padding:24px 0">
    <p>This site works best with JavaScript on. You can still reach us on WhatsApp at
      <a href={`https://wa.me/${CONFIG.whatsapp}`}>{CONFIG.phoneDisplay}</a>.</p>
  </div>
</noscript>

<script>
  import '../scripts/site.js';
</script>

</body>
</html>
