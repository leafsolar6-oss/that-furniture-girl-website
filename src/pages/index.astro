---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import FeatureStrip from '../components/sections/FeatureStrip.astro';
import Categories from '../components/sections/Categories.astro';
import Collection from '../components/sections/Collection.astro';
import Spotlight from '../components/sections/Spotlight.astro';
import Favourites from '../components/sections/Favourites.astro';
import Promo from '../components/sections/Promo.astro';
import Kinging from '../components/sections/Kinging.astro';
import CustomOrder from '../components/sections/CustomOrder.astro';
import Steps from '../components/sections/Steps.astro';
import TikTok from '../components/sections/TikTok.astro';
import Reviews from '../components/sections/Reviews.astro';
import Guides from '../components/sections/Guides.astro';
import Instagram from '../components/sections/Instagram.astro';
import Faq from '../components/sections/Faq.astro';
import Newsletter from '../components/sections/Newsletter.astro';
