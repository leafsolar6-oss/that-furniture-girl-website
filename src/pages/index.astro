---

<Base
  page="home"
  title="That Furniture Girl — Handcrafted Furniture in Ibadan, Nigeria"
  description="Handcrafted sectionals, sofas, wardrobes and centre tables made in Ibadan. Custom colours, sizes and designs, same-day delivery across Nigeria. Order on WhatsApp."
  ogTitle="That Furniture Girl — Handcrafted Furniture in Ibadan"
  ogDescription="Boucle sectionals, plush sofas, wardrobes and centre tables. Built to last, made your way."
>
  <Hero />
  <FeatureStrip />
  <Categories />
  <Collection />
  <Spotlight />
  <Favourites />
  <Promo />
  <Kinging />
  <CustomOrder />
  <Steps />
  <TikTok />
  <Reviews />
  <Guides />
  <Instagram />
  <Faq />
  <Newsletter />
