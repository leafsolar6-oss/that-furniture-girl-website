---
import Base from '../layouts/Base.astro';
import Toolbar from '../components/Toolbar.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { PRODUCTS } from '../data/products.js';
---

<Base
  page="shop"
  title="Shop — Sofas, Sets, Wardrobes & Tables | That Furniture Girl Ibadan"
  description="Every piece is made to order in Ibadan. Sofas and sectionals from ₦350,000, full sets, centre tables and wardrobes. Order on WhatsApp."
>
<section class="page-hero">
    <div class="container">
      <span class="eyebrow">The collection</span>
      <h1>Every piece is made to order.</h1>
      <p class="lead">These are our most requested designs — and each one can be finished in the colour, fabric and size that suits your space. Tap any piece for details, or order straight on WhatsApp.</p>
      <div class="page-hero__meta">
        <span>Same-day delivery in Ibadan</span>
        <span>5–10 working days to build</span>
        <span>Custom colours &amp; sizes</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Toolbar title="All pieces" gridId="shopGrid" />
      <ProductGrid products={PRODUCTS} id="shopGrid" />
      <div class="ribbon reveal" style="margin-top:clamp(30px,4vw,44px)">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Beds, dining sets, office pieces &amp; TV stands</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Prices are for the pieces as photographed</span>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Not on the list?</span>
        <h2>If you can picture it, we can build it.</h2>
        <p class="lead" style="margin-top:18px">Send us a photo of the piece you love — from TikTok, Pinterest, a friend's house or your own imagination — and we'll quote you for building it in your colours and size.</p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn--primary" href="https://wa.me/2349079849626" data-wa="Hello! I want a custom piece built. Here is the design I have in mind: ">Send us your design</a>
          <a class="btn btn--outline" href="index.html#custom">How custom orders work</a>
        </div>
      </div>
      <div class="grid-2 reveal" data-delay="1">
        <div class="card">
          <span class="card__num">01</span>
          <h3>Beds &amp; bedroom</h3>
          <p>Frames, headboards, wardrobes and bedside pieces built to your room's measurements.</p>
        </div>
        <div class="card">
          <span class="card__num">02</span>
          <h3>Dining &amp; kitchen</h3>
          <p>Dining tables, chairs and storage benches in HDF and MDF finishes.</p>
        </div>
        <div class="card">
          <span class="card__num">03</span>
          <h3>Office &amp; commercial</h3>
          <p>Desks, seating and reception pieces for offices, salons, hotels and rentals.</p>
        </div>
        <div class="card">
          <span class="card__num">04</span>
          <h3>Full house packages</h3>
          <p>Moving into a new place? We'll furnish several rooms as one coordinated build.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--wide-left" style="align-items:start">
      <div class="reveal">
        <span class="eyebrow">Before you order</span>
        <h2>Straight answers</h2>
        <p class="lead" style="margin-top:16px">Anything else you'd like to know, just ask — we're always active on WhatsApp.</p>
      </div>
      <div class="faq reveal" data-delay="1">
        <details open>
          <summary>Are the prices on this page final?</summary>
          <p>They are the prices for the pieces exactly as photographed and described. If you change the fabric, colour or size, or ask for extra detailing, the price may change — we'll always confirm the new price before we start building.</p>
        </details>
        <details>
          <summary>What if the piece I want is out of stock?</summary>
          <p>Almost nothing is kept "in stock" — most pieces are built to order, so there is no waiting for a shipment. We'll tell you the production time and keep you updated with photos as it comes together.</p>
        </details>
        <details>
          <summary>How do I pay?</summary>
          <p>Payment details are shared when you place your order on WhatsApp. Ask us about options for made-to-order pieces before we begin production.</p>
        </details>
        <details>
          <summary>Can I mix and match pieces?</summary>
          <p>Yes. Many customers order a sectional plus a centre table, or a whole living room of matching pieces. Tell us the room and we'll help you put a set together.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section section--tight cta-band">
    <div class="container cta-band__inner">
      <div class="reveal">
        <h2>Found the one?</h2>
        <p style="margin-top:16px; max-width:48ch">Send us the piece name and we'll confirm availability, price and delivery straight away.</p>
      </div>
      <div class="btn-row reveal" data-delay="1">
        <a class="btn btn--light btn--lg" href="https://wa.me/2349079849626" data-wa="Hello! I would like to order a piece from your website.">Order on WhatsApp</a>
        <a class="btn btn--ghost-light btn--lg" href="contact.html">Visit the showroom</a>
      </div>
    </div>
  </section>



</Base>
