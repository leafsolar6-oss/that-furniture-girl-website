---
/* Testimonials — "What our customers say".
   Follows the site's founding rule: the page never shows a review nobody
   wrote. The quote wall fills from TESTIMONIALS in src/data/products.js —
   paste real customer messages there and they appear here (and on the home
   page) automatically, unchanged. Until then this page carries only what is
   genuinely ours: the owner's real appreciation post and the invitation for
   customers to send theirs. */
import Base from '../layouts/Base.astro';
import { TESTIMONIALS, SHOWCASE, CONFIG } from '../data/products.js';
import { waLink } from '../lib/site.js';

const quotes = TESTIMONIALS;
const showcase = SHOWCASE.filter((s) => s && s.img);
const reviewMsg =
  'Hello That Furniture Girl! I bought from you and would love to share my experience for your reviews page.';
---

<Base
  page="reviews"
  title={`Testimonials — ${CONFIG.brand}`}
  description={`What our customers say about ${CONFIG.brand} — real messages from real customers in Ibadan and beyond, shown exactly as they were sent. Share your own experience on WhatsApp.`}
>
  <main>
    <!-- ============================== HERO ============================== -->
    <section class="section" id="reviews-top" style="padding-top:clamp(90px,12vh,140px)">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Testimonials</span>
          <h1>What our customers say</h1>
          <p class="lead" style="margin-top:14px">
            Real messages from real customers — shown exactly as they were sent to us.
            No invented praise, no borrowed words. If it is on this page, somebody
            actually wrote it to us.
          </p>
          <div class="gold-rule reveal" aria-hidden="true"><span>✦</span></div>
        </div>
      </div>
    </section>


    <!-- ============== SHOWCASE — DELIVERED, AT THEIR HOMES ============== -->
    {showcase.length > 0 && (
    <section class="section showcase-stage" id="at-home" style="padding-top:clamp(10px,2vw,26px)">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Delivered &mdash; and photographed</span>
          <h2>Straight from their homes</h2>
          <p class="lead" style="margin-top:14px">
            The part nationwide buyers keep asking about: what the pieces look like
            after they leave our van. These are the real video reviews and setup photos
            customers send back &mdash; kept exactly inside the chats and stories they
            arrived in, timestamps and all. Tap any one to open the unedited proof.
          </p>
        </div>

        <div class="showcase">
          {showcase.map((s, i) => {
            const base = s.img.replace(/\.jpg$/, '');
            return (
            <a class="showcase__item reveal" data-delay={i % 3} data-shot href={`assets/img/opt/${s.img}`}
               target="_blank" rel="noopener" aria-label={`Open the full ${s.src === 'Instagram' ? 'Instagram story' : 'WhatsApp'} screenshot — delivered setup ${i + 1}`}>
              <span class="showcase__media">
                {s.video ? (
                  <video src={s.video} poster={`assets/img/opt/${base}-480.webp`} controls muted playsinline preload="none" />
                ) : (
                  <img src={`assets/img/opt/${base}-480.webp`}
                       srcset={`assets/img/opt/${base}-160.webp 160w, assets/img/opt/${base}-480.webp 480w, assets/img/opt/${s.img} 1000w`}
                       sizes="(min-width:1024px) 30vw, (min-width:560px) 45vw, 88vw"
                       alt={s.quote ? `Customer video review from their home — they wrote: “${s.quote}”` : `Customer video review from their home, delivered setup photo ${i + 1}`}
                       loading="lazy" decoding="async" width="480" height="640" />
                )}
                {s.vid && <span class="showcase__vid" aria-label={`Video of ${s.vid} inside the screenshot`}>{"▶"} {s.vid}</span>}
                <span class={`showcase__src showcase__src--${s.src === 'Instagram' ? 'ig' : 'wa'}`}>{s.src}</span>
              </span>
              <span class="showcase__cap">
                {s.quote && <b class="showcase__quote">&ldquo;{s.quote}&rdquo;</b>}
                {s.note && <span class="showcase__note">{s.note}</span>}
              </span>
            </a>
            );
          })}
        </div>

        <p class="showcase-more reveal">
          The stories above carry the customers&rsquo; own video clips &mdash; the same reel, uncut,
          lives on our
          <a href={CONFIG.instagram} target="_blank" rel="noopener">Instagram</a> and
          <a href={CONFIG.tiktok} target="_blank" rel="noopener">TikTok</a>.
          Bought from us? Send your setup photo or video to the shop line and it can headline here next.
        </p>
      </div>
    </section>
    )}

    <!-- ================ REVIEWS — ONE STAGE, ALL THE WORDS ================ -->
    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="reviews-stage">

          <div class="section-head section-head--center reveal">
            <span class="eyebrow">The proof</span>
            <h2>Straight from the chats</h2>
            <p class="lead" style="margin-top:14px">
              Unedited screenshots from real WhatsApp and Instagram conversations.
              Tap any one to read the full chat.
            </p>
          </div>
          <div class="shot-wall">
            {[
              'review-01.jpg','review-02.jpg','review-03.jpg','review-04.jpg','review-05.jpg','review-06.jpg',
              'review-07.jpg','review-08.jpg','review-09.jpg','review-10.jpg','review-11.jpg','review-12.jpg',
              'review-13.jpg','review-14.jpg','review-15.jpg','review-16.jpg','review-17.jpg','review-18.jpg'
            ].map((s, i) => (
              <a class="shot-wall__item reveal" data-delay={i % 2} href={`assets/img/opt/${s}`} target="_blank" rel="noopener">
                <img src={`assets/img/opt/${s.replace('.jpg', '-480.jpg')}`} alt={`Customer ${s === 'review-16.jpg' ? 'Instagram' : 'WhatsApp'} review screenshot ${i + 1}`} loading="lazy" />
                <span class="shot-pill">{s === 'review-16.jpg' ? 'Instagram' : 'WhatsApp'}</span>
              </a>
            ))}
          </div>

          <div class="stage-ornament reveal" aria-hidden="true"><span>✦</span></div>

          <div class="section-head section-head--center reveal" style="margin-top:clamp(30px,5vw,56px)">
            <span class="eyebrow">In their words</span>
            <h2>Words from real customers</h2>
          </div>

          {quotes.length > 0 ? (
            <div class="review-list" id="quoteGrid">
              {quotes.map((t, i) => (
                <Fragment>
                  <figure class="review-item reveal" data-delay={i % 2}>
                    <div class="review-item__mark" aria-hidden="true">&ldquo;</div>
                    <blockquote class="review-item__text">{t.text}</blockquote>
                    <figcaption class="review-item__who">
                      {t.img
                        ? <img class="review-item__avatar" src={`assets/img/opt/${t.img}`} alt="" loading="lazy" />
                        : <span class="review-item__avatar" aria-hidden="true">{String(t.name || '?').trim().charAt(0).toUpperCase()}</span>}
                      <strong>{t.name}</strong>
                      {t.where && <span class="review-item__spark" aria-hidden="true">✦</span>}
                      {t.where && <span class="review-item__where">{t.where}</span>}
                    </figcaption>
                  </figure>
                  {i < quotes.length - 1 && <div class="review-sep" aria-hidden="true"><span>◆</span></div>}
                </Fragment>
              ))}
            </div>
          ) : (
            <div class="quote-card reveal" style="max-width:680px;margin:24px auto 0;text-align:center">
              <div class="quote-card__mark" aria-hidden="true">&ldquo;</div>
              <blockquote class="quote-card__text" style="font-size:clamp(1.05rem,2vw,1.25rem)">
                The first review on this page could be yours. Bought from us? Send us your
                honest words on WhatsApp — and with your permission we will put them here,
                exactly as you wrote them.
              </blockquote>
              <div style="margin-top:22px">
                <a class="btn btn--gold" href={waLink(reviewMsg)} data-wa={reviewMsg}>Share your experience</a>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ====================== NOTE OF APPRECIATION ====================== -->
    <section class="section" style="padding-top:clamp(18px,2.6vw,34px)">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">From our TikTok · 30 September 2026</span>
          <h2>A note of appreciation</h2>
        </div>
        <figure class="quote-card reveal" style="max-width:760px;margin:0 auto">
          <div class="quote-card__mark" aria-hidden="true">&ldquo;</div>
          <blockquote class="quote-card__text" style="font-size:clamp(1.05rem,2vw,1.2rem)">
            APPRECIATION POST 💜💜 Love y'all 🤗❤️ Your Legit furniture vendor is here oooo.
            If you like go send money give thief 😂🤣💜 Order via DM/WhatsApp — 09079849626.
            We offer same day delivery and our delivery is very fast 🚀
          </blockquote>
          <figcaption class="quote-card__head" style="margin-top:20px">
            <span class="quote-card__avatar" aria-hidden="true">T</span>
            <div class="quote-card__who">
              <strong>That Furniture Girl</strong>
              <span>Appreciation post on TikTok</span>
            </div>
          </figcaption>
        </figure>
        <div class="reveal" style="text-align:center;margin-top:26px">
          <a class="btn btn--ghost btn--sm" href={CONFIG.tiktok} target="_blank" rel="noopener">See the post on TikTok</a>
        </div>
      </div>
    </section>

    <!-- ============================ TRUST STRIP ============================ -->
    <section class="section" style="padding-top:clamp(18px,2.6vw,34px)">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Why they keep coming back</span>
          <h2>Made in Ibadan, delivered with care</h2>
        </div>
        <div class="quote-grid">
          <div class="trust-card reveal" data-delay="0">
            <div class="trust-card__rule"></div>
            <h3>Same-day delivery</h3>
            <p>Order confirmed today, at your door today — our delivery is fast.</p>
          </div>
          <div class="trust-card reveal" data-delay="1">
            <div class="trust-card__rule"></div>
            <h3>Walk-in store, Ibadan</h3>
            <p>Come see and feel every piece before you pay. Crafted for real living.</p>
          </div>
          <div class="trust-card reveal" data-delay="0">
            <div class="trust-card__rule"></div>
            <h3>Made to your taste</h3>
            <p>Custom colours, sizes and designs — every piece can be made your way.</p>
          </div>
          <div class="trust-card reveal" data-delay="1">
            <div class="trust-card__rule"></div>
            <h3>Legit vendor</h3>
            <p>Real furniture, real photos, real people on WhatsApp: {CONFIG.whatsapp}.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =============================== CTA =============================== -->
    <section class="section" style="padding-top:clamp(18px,2.6vw,34px)">
      <div class="container">
        <div class="cta-band reveal" style="text-align:center">
          <span class="eyebrow">Join the family</span>
          <h2 style="margin:0;color:#fff">Bought from us? Your words belong here.</h2>
          <p class="lead" style="margin-top:12px;color:rgba(255,255,255,.78)">
            Tell us how your furniture is holding up, how the delivery went, or how the
            piece changed your space. We read every message.
          </p>
          <div style="margin-top:24px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a class="btn btn--gold" href={waLink(reviewMsg)} data-wa={reviewMsg}>Send a WhatsApp review</a>
            <a class="btn btn--ghost-light" href="products.html">Browse the collection</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
